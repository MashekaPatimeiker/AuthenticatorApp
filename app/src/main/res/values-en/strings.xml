    <!-- Instructions -->
    <string name="how_to_step_1">1. Add account</string>
    <string name="how_to_step_1_desc">Tap the + icon in the top right corner. Choose:\n• Scan QR code from website\n• Enter data manually\n• Paste secret from clipboard</string>
    <string name="how_to_step_2">2. Get code</string>
    <string name="how_to_step_2_desc">Code updates every 30 seconds. Progress bar shows remaining time.</string>
    <string name="how_to_step_3">3. Manage accounts</string>
    <string name="how_to_step_3_desc">• Swipe left — delete account (with confirmation)\n• Swipe right — view account information</string>
    <string name="how_to_step_4">4. Settings</string>
    <string name="how_to_step_4_desc">In settings you can:\n• Enable dark theme\n• Change app language\n• Contact developer</string>
    <string name="how_to_step_5">5. Security</string>
    <string name="how_to_step_5_desc">All data is stored locally on your device. No data is transmitted over the internet.</string>
